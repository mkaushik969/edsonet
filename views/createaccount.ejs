                        </div>
                        </div>

                        <div class="form-group">
                        <label class="control-label col-sm-3">Password</label>
                        <div class="col-sm-8">
                        <input type="password" placeholder="Enter password" name="pass" class="form-control">
                        </div>
                        </div>

                        <div class="form-group">
                        <label class="control-label col-sm-3">Confirm Password</label>
                        <div class="col-sm-8">
                        <input type="password" placeholder="Re-enter password" name="cpass" class="form-control">
                        </div>
                        </div>

                        <div class="form-group">
                        <label class="control-label col-sm-3" for="email">Email</label>
                        <div class="col-sm-8">
                        <input type="email" placeholder="Email" name="email" class="form-control">
                        </div>
                        </div>
                        
                         <div class="form-group">
                        <label class="control-label col-sm-3" for="contact">Contact</label>
                        <div class="col-sm-8">
                        <input type="text" placeholder="Phone Number" name="contact" class="form-control">
                        </div>
                        </div>

                        <div class="form-group">
                        <label class="control-label col-sm-3" for="institution">Institution</label>
                        <div class="col-sm-8">
                        <input type="text" placeholder="Institution" name="ins" class="form-control">
                        </div>
                        </div>


                         <div class="form-group">
                        <label class="control-label col-sm-3">City</label>
                        <div class="col-sm-8">
                        <input type="text" placeholder="Enter City Name" name="city" class="form-control">
                        </div>
                        </div>


                        <div class="form-group">
                        <label class="control-label col-sm-3">Profile picture</label>
                        <div class="col-sm-8">
                        <input type='file' id="imgInp" name="image" accept="image/x-png,image/jpeg" /><br>
                        <img id="uploaded_img" src="#" />
                        </div>
                        </div>

                        
                      <div class="form-group">
                        <label class="col-sm-offset-3 col-sm-8">
                            <input type="submit" value="Submit" name="submit" class="btn btn-default">
                        </label>
                      </div>

                        <div style="float:left; font-size:80%;">Already Registered ? <a href="/account"> Click here</a> to login.</div>

                    </form>
