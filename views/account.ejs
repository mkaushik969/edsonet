    <script type="text/javascript">
        function validateform()
        {
    var pass= document.forms["f2"]["pass"].value;
    var email= document.forms["f2"]["email"].value;
    
    $("#demail").hide();
    $("#dpass").hide();
    if(!(/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/.test(email)))
    {
        $("#demail").show();
        return false;
    }
    else if(pass=="" || pass==" " || pass.length<7 || pass.length>15)
    {
        $("#dpass").show();
        return false;
    }
    else
    {
        
    $.ajax({  
        type: "POST",
        url: "http://13.127.31.254:3000/login",  
        data: {'email': email,'pass': pass},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('hello:', dataString); 
                if(dataString.response=="success"){
                    top.location.href = '/timeline';
//                    alert("success");  
//                     window.location.href = 'http://13.127.31.254:3000/signup';
                }
                else{
                    alert("Incorrect Email or Password");
                }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
    return false;
    }
}
    </script>
