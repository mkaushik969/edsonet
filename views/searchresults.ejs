	<script type="text/javascript">

    var query = '<%=txt %>' ;

    function getsearch()
    {
        getuser();
        getposts();
    }

var obj,i;
var pid, msg,pimage,email,cdate,uimage,type;
var element,pfname, plname;
function getuser()
{

    $.ajax({  
        type: "POST",  
        url: "http://13.127.76.231:3000/getusersearchresults",  
        data: {txt:query},  
        success: function(dataString) {        
//            alert("OKKKKK");  
           console.log('hello:', dataString); 
                if(dataString.response=="success"){
                   obj=dataString.data;
                   //alert(obj.length);
				   for(i=0;i<obj.length;i++)
				   {				   
				   pfname=obj[i].firstname;
				   plname=obj[i].lastname;
				   email=obj[i].email;
				   uimage=obj[i].image;
                   ucity=obj[i].city;
				   	element= '<div class="card-post">'+
                    '<div class="row">'+
                    '<div class="col-xs-3 col-sm-2">'+
                                '<img src=';
                    if(uimage)
                    {
                        element=element+ uimage+' alt="User name" class="img-circle img-user" style="height:50px;width:5px;">'+
                             '</div>'+
                    '<div class="col-xs-9 col-sm-10 info-user">'+
                       '<form action="/profile" method="post">'+
                        '<input type="submit" value="'+pfname+' ' +plname+'" name="name" style="border:none;background-color:white;font-size:15px;font-weight:bold;">'+
                        '<input type="hidden" value="'+email+'" name="email">'+
                        '</form>'+
                        '<h4><b>'+ucity+'</b></h4>'+
                    '</div>'+  '</div><br>'+   '</div>';
                    }
                    else
                    {
                        element=element+'"img/user.jpg"'+' alt="User name" class="img-circle img-user" style="height:50px;width:5px;">'+
                        '</div>'+
                    '<div class="col-xs-9 col-sm-10 info-user">'+
                       '<form action="/profile" method="post">'+
                        '<input type="submit" value="'+pfname+' ' +plname+'" name="name" style="border:none;background-color:white;font-size:15px;font-weight:bold;">'+
                        '<input type="hidden" value="'+email+'" name="email">'+
                        '</form>'+
                        '<h4><b>'+ucity+'</b></h4>'+
                    '</div>'+  '</div><br>'+     '</div>';
                    }
                     
                            $("#posts-container1").append(element);
						}  
                }
                else{
                    alert("error");
                }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
    return false;
}


var element1;
function getposts()
{

    $.ajax({  
        type: "POST",  
