            </div>
        </div>
       
       
    </header>
      


<script>

function logout()
{
        $.ajax({  
        type: "GET",  
        url: "http://13.127.76.231:3000/userlogout",
        data: {},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('hello:', dataString); 
                if(dataString.response=="success"){
                    window.location.href = '/home';
                }
                else{
                    alert("Error");
                }            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });

}

</script>


</div>
