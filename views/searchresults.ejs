                    '</div>'+
                    '<div class="col-xs-9 col-sm-10 info-user">'+
                       '<form action="/profile" method="post">'+
                        '<input type="submit" value="'+pfname+' ' +plname+'" name="name" style="border:none;background-color:white;font-size:15px;font-weight:bold;">'+
                        '<input type="hidden" value="'+email+'" name="email">'+
                        '</form>'+
                        '<p><i>'+cdate+'</i></p>'+
                    '</div>'+
                    '</div><br>'+
                    '<div class="row">'+
                    '<div class=" col-sm-8 col-sm-offset-2 data-post">'+
                        '<p>'+msg+' </p>'+
                        '<img src='+pimage+' class="img-post">'+
                    '</div>'+
                    '</div>'+
                    '</div>';
                    }
                     $("#posts-container2").append(element);
                     
                   }




                    if(type==2)
                   {
                    element1= '<div class="card-post">'+
                    '<div class="row">'+
                    '<div class="col-xs-3 col-sm-2">'+
                            '<a href="#">'+
                                '<img src=';

                        if(uimage)
                        {
                            element1=element1+'"'+uimage+'"  alt="User name" class="img-circle img-user" style="height:50px;width:5px;">'+
                            '</a>'+'</div>'+
                    '<div class="col-xs-9 col-sm-10 info-user">'+
                       '<form action="/profile" method="post">'+
                        '<input type="submit" value="'+pfname+' ' +plname+'" name="name" style="border:none;background-color:white;font-size:15px;font-weight:bold;">'+
                        '<input type="hidden" value="'+email+'" name="email">'+
                        '</form>'+
                        '<p><i>'+cdate+'</i></p>'+
                    '</div>'+'</div>'+ '<div class="row">'+
                    '<div class=" col-sm-8 col-sm-offset-2 data-post">'+
                        '<p>'+msg+' </p>'+
                 '<input type="button" name="taketest" value="Take Test" id="taketest" onclick="taketest()" class="btn btn-default">'+
                  '</div>'+ '</div>'+  '</div>';

                        }
                        else
                        {
            element1=element1+'"img/user.jpg"'+' alt="User name" class="img-circle img-user" style="height:50px;width:5px;">'+   '</a>'+'</div>'+
                    '<div class="col-xs-9 col-sm-10 info-user">'+
                       '<form action="/profile" method="post">'+
                        '<input type="submit" value="'+pfname+' ' +plname+'" name="name" style="border:none;background-color:white;font-size:15px;font-weight:bold;">'+
                        '<input type="hidden" value="'+email+'" name="email">'+
                        '</form>'+
                        '<p><i>'+cdate+'</i></p>'+
                    '</div>'+
                    '</div>'+
                    '<div class="row">'+
                    '<div class=" col-sm-8 col-sm-offset-2 data-post">'+
                        '<p><a>'+msg+'</a> </p>'+
                    '<input type="button" name="taketest" value="Take Test" id="taketest" onclick="taketest()" class="btn btn-default">'+
                        '</div>'+
                    '</div>'+
                    '</div>';
                   }
                    $("#posts-container3").append(element1);
                  }
                           
                   } 
                }
