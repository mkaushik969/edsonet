<script type="text/javascript">
  $(document).ready(function(){
    $("#selct11").change(function(){
        $(this).find("option:selected").each(function(){
            var optionValue1 = $(this).attr("value");
            if(optionValue1=="cs")
            {
              $("#civil").hide();
              $("#cs").show();
            }
            else if(optionValue1=="civil")
            {
              $("#cs").hide();
              $("#civil").show();
            }

          });
      }).change();
  });
</script>

<script type="text/javascript">
  $(document).ready(function(){
    $("#selct111").change(function(){
        $(this).find("option:selected").each(function(){
            var optionValue1 = $(this).attr("value");
            if(optionValue1=="phy")
            {
              $("#chem").hide();
              $("#maths").hide();
              $("#phy").show();
              
            }
            else if(optionValue1=="chem")
            {
              $("#chem").show();
              $("#maths").hide();
              $("#phy").hide();
            }
            else  if(optionValue1=="maths")
            {
                $("#chem").hide();
                $("#phy").hide();
                $("#maths").show();
            }

          });
      }).change();
  });
</script>

