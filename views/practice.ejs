}           
  

  
  function makepostrequest(path, params, method)
  {
        method = method || "post"; // Set method to post by default if not specified.

    // The rest of this code assumes you are not using a library.
    // It can be made less wordy if you use one.
    var form = document.createElement("form");
    form.setAttribute("method", method);
    form.setAttribute("action", path);

    for(var key in params) {
        if(params.hasOwnProperty(key)) {
            var hiddenField = document.createElement("input");
            hiddenField.setAttribute("type", "hidden");
            hiddenField.setAttribute("name", key);
            hiddenField.setAttribute("value", params[key]);

            form.appendChild(hiddenField);
        }
    }

    document.body.appendChild(form);
    form.submit();
  }

    function getq(x,y,z)
    {
        makepostrequest("/practice",{class:x,course:y,tagid:z},"post");
    }

function chkans(x,y)
{
  //alert(x);
  //alert(y);
  var anss=obj1[y-1].correct;
  var cid;
  if(obj1[y-1].opt1id==anss)
  {
    cid=obj1[y-1].opt1;
  }
  if(obj1[y-1].opt2id==anss)
  {
    cid=obj1[y-1].opt2;
  }
  if(obj1[y-1].opt3id==anss)
  {
    cid=obj1[y-1].opt3;
  }
  if(obj1[y-1].opt4id==anss)
  {
    cid=obj1[y-1].opt4;
  }
  //alert(anss);
  var vans;
  var y1;
  if(x==1)
   {
       vans=obj1[y-1].opt1id;
       y1=obj1[y-1].opt1;
   }
   if(x==2)
     {
         vans=obj1[y-1].opt2id;
         y1=obj1[y-1].opt2;
    }
    if(x==3)
     {
         vans=obj1[y-1].opt3id;
         y1=obj1[y-1].opt3;
          }
    if(x==4)
   {
       vans=obj1[y-1].opt4id;
       y1=obj1[y-1].opt4;
   }
   if(anss==vans)
    {
        document.getElementById("output"+y).innerHTML="<b>STATUS:</b>  Correct Answer";
        //document.getElementById("ans"+y).textContent=y1;
        document.getElementById("exp"+y).innerHTML="<b>EXPLANATION: </b> "+obj1[y-1].exp;
    }
    else
   
    {
        document.getElementById("output"+y).innerHTML="<b>STATUS: </b> Wrong Answer";
        document.getElementById("ans"+y).innerHTML="<b>CORRECT ANSWER  </b> "+cid;
        document.getElementById("exp"+y).innerHTML="<b>EXPLANATION:  </b>"+obj1[y-1].exp;
   }

}


