<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script type="text/javascript">
var obj;
    function getinstructions()
    {

    var testid = '<%=tid %>' ;
            $.ajax({  
        type: "POST",  
        url: "http://13.127.31.254:3000/getinstructions",  
        data: {tid:testid},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('hello:', dataString); 
                if(dataString.response=="success"){
                   // top.location.href = '/portal';
                   
                   var subject=dataString.subject.name;
                   var difficulty=dataString.test.level;
                   var username=dataString.user.firstname;
                   var timer=dataString.test.timer;
                   var d;
                   if(difficulty==1)
                   {
                    d="EASY";
                   }
                   if(difficulty==2)
                   {
                    d="MEDIUM";
                   }                   
                   if(difficulty==3)
                   {
                    d="HARD";
                   }
                   document.getElementById("user").textContent=" "+username;
                   document.getElementById("tym").textContent=" "+timer+" min";
                   document.getElementById("sub").textContent=" "+subject; 
                   document.getElementById("dif").textContent=" "+d;                  


                }
                else{
                    alert("User Already Registered");
                }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
    }
</script>
</head>

