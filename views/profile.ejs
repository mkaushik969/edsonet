<body id="personal" onload="getprofile()">

    <script type="text/javascript">

var email22;
function getprofile()
{
    var myemail = '<%=email %>' ;

     $.ajax({  
        type: "POST",  
        url: "http://13.127.76.231:3000/getprofile",
        data: {email:myemail},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('hello:', dataString); 
            if(dataString.response=="success"){
            var obj=dataString.data;
            
            email22=obj.email;

            document.getElementById("user").innerHTML=obj.firstname+" "+obj.lastname;
            document.getElementById("city").textContent=obj.city;
            document.getElementById("email").textContent=obj.email;
            document.getElementById("phno").textContent=obj.phoneno;     
            document.getElementById("fname").textContent=obj.firstname;
            var img2=new Image();
           if(obj.image)
                        {
                        img2.src=obj.image;
                        img2.setAttribute("class","img-circle img-user");
                        //img2.setAttribute("style","height:20px;width:15px;");
                        //img1.setAttribute("alt","effy1");
                        document.getElementById("uimg").appendChild(img2);
                        }
                        else
                        {
                        img2.src="img/user.jpg";
                        img2.setAttribute("class","img-circle img-user");
                       // img2.setAttribute("style","height:20px;width:15px;");
                        //img1.setAttribute("alt","effy1");
                        document.getElementById("uimg").appendChild(img2);
                        }
                getfollowstatus();
              }
           else{
           alert("Error1");
          }            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
}

function getfollowstatus() {
    var myemail = '<%=email %>' ;

    $.ajax({  
        type: "POST",  
        url: "http://13.127.76.231:3000/isfollowing",
        data: {email:email22},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('followstatus', dataString); 
            if(dataString.response=="success"){

            var follow=dataString.follow;

            if(follow==1)
            {
                document.getElementById("follow1").value="FOLLOWING";
                document.getElementById("follow1").style.backgroundColor="green";
                document.getElementById("follow1").style.color="white";
            }
            else if(follow==0)
            {
                document.getElementById("follow1").value="FOLLOW";
            }
            else if(follow==-1)
            {
                $("#follow1").hide();
            }
}



/*            var y=document.getElementById("follow1").value;
            if(y=="FOLLOW")
            {
                document.getElementById("follow1").value="FOLLOWING";
                document.getElementById("follow1").style.background-color="green";
              }
              if(y=="FOLLOWING")
              {
                document.getElementById("follow1").value="FOLLOW";
              }
            }
*/                      
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });


}

function followuser()
{
    var myemail = '<%=email %>' ;

    $.ajax({  
        type: "POST",  
        url: "http://13.127.76.231:3000/followuser",
        data: {email2:email22},  
        success: function(dataString) {        
//            alert("OKKKKK");  
            console.log('followuser:', dataString); 
            if(dataString.response=="success"){
            var y=document.getElementById("follow1").value;
            if(y=="FOLLOW")
            {
                document.getElementById("follow1").value="FOLLOWING";
               // document.getElementById("follow1").style.backgroundColor="green";
                //document.getElementById("follow1").style.color="white";
              }
              if(y=="FOLLOWING")
              {
                document.getElementById("follow1").value="FOLLOW";
              }
            }
                      
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
}

