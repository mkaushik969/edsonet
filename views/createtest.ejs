<script type="text/javascript">
$(document).ready(function(){
    $("#selct1").change(function(){
        $(this).find("option:selected").each(function(){
            var optionValue = $(this).attr("value"); 
            if(optionValue==2){ 
                $("#gate").hide();           
                $("#mains").show();
              
            }

            if(optionValue==1){
              $("#mains").hide();
               $("#gate").show();
              
            }
        });
    }).change();
});
</script>

