<script type="text/javascript">
  $(document).ready(function(){
    $("#selct111").change(function(){
        $(this).find("option:selected").each(function(){
            var optionValue1 = $(this).attr("value");
            if(optionValue1==3)
            {
              $("#chem").hide();
              $("#maths").hide();
              $("#phy").show();
              
            }
            else if(optionValue1==2)
            {
              $("#chem").show();
              $("#maths").hide();
