<script type="text/javascript">
var gdata;

function sendRequest(){
var j,k,res,x;
var email = '<%=email %>' ;
var tid = '<%=tid %>' ;
var data=[];
var obj={};
obj["email"]=email;
obj["tid"]=tid;
for(j=1;j<=10;j++)
{
var radiobtn=document.getElementsByClassName('opt'+j);
for(k=0;k<radiobtn.length;k++)
{
  if(radiobtn[k].checked)
    x=radiobtn[k].value;
}
if(x==1)
  res=(gdata[j-1].opt1id);
else if(x==2)
  res=(gdata[j-1].opt2id);
else if(x==3)
  res=(gdata[j-1].opt3id);
else if(x==4)
  res=(gdata[j-1].opt4id);

data.push({qid:gdata[j-1].qid,aid:res});
}
obj["data"]=JSON.stringify(data);
console.log(obj);

 $.ajax({  
        type: "POST",  
        url: "http://13.127.31.254:3000/submittest",  
        data: obj,  
        success: function(dataString) {        
        console.log('hello:', dataString);
        localStorage.setItem('response', dataString.response);
        localStorage.setItem('correct', dataString.correct);
        localStorage.setItem('incorrect', dataString.incorrect);
        window.location.href = '/testresult';     
      },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });

}

function getQ(){
        var email = '<%=email %>' ;
        var tid = '<%=tid %>' ;
 
 $.ajax({  
        type: "POST",  
        url: "http://13.127.31.254:3000/gettest",  
        data: { 'email':email,'tid':tid},  
        success: function(dataString) {        
        console.log('hello:', dataString); 
        if(dataString.data.length>0){
          var myObj;
          myObj = dataString.data;
          gdata=myObj;
          var i;
          for(i=0;i<myObj.length;i++)
          {
          var j=i+1;
          if(myObj[i].ques)
          {
          document.getElementById("ques"+j).innerHTML = myObj[i].ques;
          }
          else
          {
            var img = new Image();
          img.src = myObj[i].qimage;
          img.setAttribute("class", "banner-img");
          //img.setAttribute("alt", "effy");
          document.getElementById("img-container1").appendChild(img);
          }

          if(myObj[i].opt1)
          {
            document.getElementById("opt"+j+"1").innerHTML = myObj[i].opt1;
          }
          else
          {
            var img1=new Image();
              img1.src=myObj[i].opt1image;
              img1.setAttribute("class","banner-img");
              //img1.setAttribute("alt","effy1");
              document.getElementById("img-container"+j+"1").appendChild(img1);
          }
          
          if(myObj[i].opt2)
          {
            document.getElementById("opt"+j+"2").innerHTML = myObj[i].opt2;
          }
          else
          {
            var img2=new Image();
          img2.src=myObj[i].opt2image;
          img2.setAttribute("class","banner-img");
          //img2.setAttribute("alt","effy1");
          document.getElementById("img-container"+j+"2").appendChild(img2);
          }

          if(myObj[i].opt3)
          {
            document.getElementById("opt"+j+"3").innerHTML = myObj[i].opt3;
          }
          else
          {
                var img3=new Image();
          img3.src=myObj[i].opt3image;
          img3.setAttribute("class","banner-img");
          //img3.setAttribute("alt","effy1");
          document.getElementById("img-container"+j+"3").appendChild(img3);
          }

          if(myObj[i].opt4)
          {      
           document.getElementById("opt"+j+"4").innerHTML = myObj[i].opt4;
          }
          else
            {   
             var img4=new Image();
          img4.src=myObj[i].opt4image;
          img4.setAttribute("class","banner-img");
          //img4.setAttribute("alt","effy1");
          document.getElementById("img-container"+j+"4").appendChild(img4);
          }

          }
                }
                else{
                    alert("Something's wrong");
                }
            
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.log('errmsg:'+errorThrown.message);
           alert('No Internet Connection');
    }  
    });
    return false;

}

</script>
